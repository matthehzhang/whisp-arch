[Unit]
Description=whisp-arch push-to-talk dictation daemon
Documentation=https://github.com/matthew/whisp-arch
# Only useful inside a graphical (Wayland/Hyprland) session: it types into the
# focused window (wtype) and reads the PipeWire-pulse server + evdev devices.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/projects/mini/whisp-arch/target/release/whisp-arch
Restart=on-failure
RestartSec=2
# wtype needs the compositor's Wayland socket; pull it from the session env.
# `systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR` in your
# session (or a graphical-session.target drop-in) makes these available.

[Install]
WantedBy=graphical-session.target
